amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

local checks = new Mapping<String, Step> {
    ["bench"] {
        glob = "*_bench.ts"
        check = "pnpm bench"
    }
    ["biome"] {
        glob = "*.ts"
        check = "pnpm biome check {{files}}"
        fix = "pnpm biome check --write {{files}}"
    }
    ["check"] {
        glob = "*.ts"
        check = "pnpm check"
    }
    ["fmt"] {
        check = "pnpm exec dprint check {{files}}"
        fix = "pnpm exec dprint fmt {{files}}"
    }
    ["test"] {
        glob = "*_test.ts"
        check = "pnpm test"
    }
    ["test:e2e"] {
        glob = "*.ts"
        check = "pnpm test:e2e --project=chrome"
        // profiles = "slow")
    }
}

hooks {
    ["check"] {
        steps = checks
    }
    ["pre-commit"] {
        fix = true
        steps = checks
    }
}
