{
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "biome": {
  },
  "typescript": {
    "module.sortImportDeclarations": "maintain",
    "quoteStyle": "preferDouble",
    "semicolons": "asi"
  },
  "json": {
  },
  "markdown": {
    "textWrap": "maintain"
  },
  "toml": {
  },
  "malva": {
  },
  "markup": {
  },
  "yaml": {
  },
  "excludes": [
    "**/*-lock.yaml",
    "**/*.min.js",
    "**/*.vto",
    "**/node_modules",
    ".copier-answers.yml",
    "coverage",
    "dist",
    "playwright-report",
    "public",
    "test-results"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.99.2.wasm",
    "https://plugins.dprint.dev/json-0.26.0.wasm",
    "https://plugins.dprint.dev/markdown-0.29.0.wasm",
    "https://plugins.dprint.dev/toml-0.10.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.6.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/biome-0.15.5.wasm"
  ]
}
