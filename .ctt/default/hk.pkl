amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

steps {
    ["bench"] {
        glob = "*_bench.ts"
        check = "pnpm bench"
    }
    ["biome"] {
        glob = "*.ts"
        check = "pnpm biome check {{files}}"
        fix = "pnpm biome check --write {{files}}"
    }
    ["check"] {
        glob = "*.ts"
        check = "pnpm check"
    }
    ["fmt"] {
        check = "pnpm exec dprint check {{files}}"
        fix = "pnpm exec dprint fmt {{files}}"
    }
    ["test"] {
        glob = "*_test.ts"
        check = "pnpm test"
    }
    ["test:e2e"] {
        glob = "*.ts"
        check = "pnpm test:e2e --project=chrome"
        // profiles = "slow")
    }
}
