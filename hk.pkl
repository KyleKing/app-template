amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        steps {
            // Regenerates .ctt/ so an out-of-date generated project fails the commit
            ["ctt"] {
                glob = List("app_template/**", "copier.yml", "ctt.toml")
                check = "mise run ctt"
            }
        }
    }
}
