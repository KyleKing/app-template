// Tool and GitHub Action versions shipped to generated projects. Each one is a
// literal in the file that consumes it. This file records where those literals
// are and how to resolve the latest value. pkl in generated projects is absent on purpose,
// because it tracks "latest" rather than a pinned literal.
//
// A site that matches a different number of times than `expect` fails the run.
// A pattern that silently stops matching is how a pin goes stale unnoticed.

amends "package://github.com/kyleking/doneram/releases/download/v0.6.0/doneram@0.6.0#/Config.pkl"
import "package://github.com/kyleking/doneram/releases/download/v0.6.0/doneram@0.6.0#/Config.pkl"

/// Brings the rendered .ctt output back in sync after any patch.
afterPatch = "mise run ctt"

local copierYml = "copier.yml"
local ciYml = "app_template/.github/workflows/ci.yml.jinja"
local rootCiYml = ".github/workflows/ci.yml"
local rootBumpYml = ".github/workflows/bump_version.yml"
local rootFreshnessYml = ".github/workflows/freshness.yml"
local pkgFreshnessYml = "app_template/.github/workflows/freshness.yml"
local miseToml = "mise.toml"

/// A mise tool pin in this repo's own dev environment.
local function misePin(key: String): Config.Site = new {
  file = miseToml
  pattern = #"\#(key) = "([\d.]+)""#
}

/// A mise tool pin in the template's generated `mise.toml`.
local function templateMisePin(key: String): Config.Site = new {
  file = "app_template/mise.toml.jinja"
  pattern = #"\#(key) = "([\d.]+)""#
}

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String, sourceFile: String, count: Int): Config.Site = new {
  file = sourceFile
  pattern = #"\#(action)@([0-9a-f]{40} # v[\d.]+)"#
  expect = count
}

tools = new {
  ["actionlint"] = new {
    resolver = "mise"
    sites = new { templateMisePin("actionlint") }
  }
  ["action-gh-release"] = new {
    resolver = "github-action"
    resolverName = "softprops/action-gh-release"
    sites = new { actionPin("softprops/action-gh-release", rootBumpYml, 1) }
  }
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout", ciYml, 1)
      actionPin("actions/checkout", rootCiYml, 2)
      actionPin("actions/checkout", rootBumpYml, 1)
      actionPin("actions/checkout", rootFreshnessYml, 1)
      actionPin("actions/checkout", pkgFreshnessYml, 1)
    }
  }
  ["create-github-app-token"] = new {
    resolver = "github-action"
    resolverName = "actions/create-github-app-token"
    sites = new { actionPin("actions/create-github-app-token", rootFreshnessYml, 1)
      actionPin("actions/create-github-app-token", pkgFreshnessYml, 1) }
  }
  ["create-pull-request"] = new {
    resolver = "github-action"
    resolverName = "peter-evans/create-pull-request"
    sites = new { actionPin("peter-evans/create-pull-request", rootFreshnessYml, 1)
      actionPin("peter-evans/create-pull-request", pkgFreshnessYml, 1) }
  }
  ["doneram"] = new {
    resolver = "github-action"
    resolverName = "kyleking/doneram"
    sites = new { actionPin("kyleking/doneram", rootFreshnessYml, 1)
      actionPin("kyleking/doneram", pkgFreshnessYml, 1) }
  }
  ["doneram-schema"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"releases/download/v([\d.]+)/doneram"#
      }
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"doneram@([\d.]+)#/Config\.pkl"#
      }
    }
  }
  ["doneram-version"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site {
        file = rootFreshnessYml
        pattern = #"version: v([\d.]+)"#
      }
    }
  }
  ["hk"] = new {
    // hk.pkl and mise.toml both interpolate the hk_version copier answer, so its
    // default is the only literal. expect = 1 fails the run if copier.yml ever
    // grows a second bare numeric default for this to confuse itself with.
    sites = new {
      new Config.Site {
        file = copierYml
        pattern = #"^  default: "([\d.]+)""#
      }
    }
  }
  ["mise-action"] = new {
    resolver = "github-action"
    resolverName = "jdx/mise-action"
    sites = new {
      actionPin("jdx/mise-action", ciYml, 1)
      actionPin("jdx/mise-action", rootCiYml, 1)
      actionPin("jdx/mise-action", rootFreshnessYml, 1)
      actionPin("jdx/mise-action", pkgFreshnessYml, 1)
    }
  }
  ["pkl"] = new {
    resolver = "mise"
    sites = new { misePin("pkl") }
  }
  ["python"] = new {
    resolver = "mise"
    sites = new { misePin("python") }
  }
  ["shellcheck"] = new {
    resolver = "mise"
    sites = new { templateMisePin("shellcheck") }
  }
  ["setup-uv"] = new {
    resolver = "github-action"
    resolverName = "astral-sh/setup-uv"
    sites = new {
      actionPin("astral-sh/setup-uv", rootCiYml, 1)
      actionPin("astral-sh/setup-uv", rootFreshnessYml, 1)
    }
  }
  ["typos"] = new {
    resolver = "mise"
    sites = new { templateMisePin("typos") }
  }
  ["uv"] = new {
    resolver = "mise"
    sites = new { misePin("uv") }
  }
  ["yamllint"] = new {
    resolver = "mise"
    resolverName = "pipx:yamllint"
    sites = new { templateMisePin("\"pipx:yamllint\"") }
  }
}
